# Aplicação
APP_URL=http://localhost:3000
SESSION_SECRET=troque-por-uma-chave-longa-com-pelo-menos-24-caracteres

# Banco principal (Render PostgreSQL em produção)
DATABASE_URL=

# Supabase opcional como fallback
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Twitch Developer Application
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# Opcional para o webhook legado; o fluxo dinâmico usa EventSub WebSocket.
TWITCH_EVENTSUB_SECRET=

# Kick Developer Application
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=
# Opcional: se vazio, a aplicação busca a chave pública oficial automaticamente.
KICK_PUBLIC_KEY=

# YouTube / Google Cloud
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
YOUTUBE_API_KEY=
